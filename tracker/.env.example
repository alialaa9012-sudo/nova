# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git أبداً.

# توكن البوت من BotFather
BOT_TOKEN=123456:ABC-your-token-here

# معرّف تليجرام الوحيد المسموح له باستخدام البوت
ALLOWED_USER_ID=6493959847

# رابط قاعدة البيانات (Neon في الإنتاج، SQLite محلياً)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL=sqlite+aiosqlite:///./local.db

# العنوان العام للخدمة بعد النشر (بدون / في النهاية)
PUBLIC_URL=https://daily-tracker.onrender.com

# أسرار عشوائية طويلة — ولّدها بـ: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-long-random-string

# المنطقة الزمنية
TIMEZONE=Africa/Cairo
