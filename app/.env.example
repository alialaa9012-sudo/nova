# Copy to .env.live.local and build with `npm run build:live`. The plain build, the tests and the
# Artifact stay on the local demo backend. Both values are public by design (Project Settings, API in Supabase).
# Never put the service_role key or the database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
