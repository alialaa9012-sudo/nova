# The live build (npm run build:live) reads its Supabase settings from .env.live, which is in git
# because both values are public by design. The plain build, the tests and the Artifact stay on the
# local demo backend. Never put the service_role key or the database password in any env file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
