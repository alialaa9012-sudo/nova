# ===== NOVA — متغيرات التشغيل =====
# 1) رابط قاعدة البيانات من Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 2) مفتاح سري لتوقيع جلسات الدخول — اكتب أي نص عشوائي طويل (32 حرف على الأقل)
JWT_SECRET=change-me-to-a-long-random-string

# 3) البورت (اختياري)
PORT=3000

# 4) بيئة التشغيل: development أو production
NODE_ENV=development
